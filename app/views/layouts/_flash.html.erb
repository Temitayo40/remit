<% if notice.present? %>
  <div id="notice" role="status" class="mb-5 rounded-lg bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-800"><%= notice %></div>
<% end %>

<% if alert.present? %>
  <div id="alert" role="alert" class="mb-5 rounded-lg bg-red-50 px-3 py-2 text-sm font-medium text-red-700"><%= alert %></div>
<% end %>
