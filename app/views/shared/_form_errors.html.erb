<% if model.errors.any? %>
  <div id="form_errors" role="alert" class="mb-5 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
    <p class="font-medium">Please fix the following:</p>
    <ul class="mt-1 list-disc pl-5">
      <% model.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
