<% content_for :title, "Choose a new password · Remit" %>

<h1 class="text-2xl font-bold">Choose a new password</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-5" do |form| %>
  <%= render "shared/form_errors", model: @user %>

  <div>
    <%= form.label :password, "New password", class: "label" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
          minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, class: "input" %>
    <p class="hint">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</p>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm new password", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>

  <%= form.submit "Save password", class: "btn-primary" %>
<% end %>
