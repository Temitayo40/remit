<% content_for :title, "Reset password · Remit" %>

<h1 class="text-2xl font-bold">Forgot your password?</h1>
<p class="mt-1 text-sm text-gray-600">We'll email you a link to set a new one.</p>

<%= form_with url: passwords_path, class: "mt-6 space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], class: "input" %>
  </div>

  <%= form.submit "Email reset link", class: "btn-primary" %>
<% end %>

<p class="mt-6 text-sm"><%= link_to "Back to log in", new_session_path, class: "link" %></p>
