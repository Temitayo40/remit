<% content_for :title, "Create your account · Remit" %>

<h1 class="text-2xl font-bold">Create your account</h1>
<p class="mt-1 text-sm text-gray-600">Know exactly who owes what, on every vehicle, today.</p>

<%= form_with model: @user, url: registration_path, class: "mt-6 space-y-5" do |form| %>
  <%= render "shared/form_errors", model: @user %>

  <div>
    <%= form.label :name, "Your name", class: "label" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "input" %>
  </div>

  <div>
    <%= form.label :phone, "Phone number", class: "label" %>
    <%= form.telephone_field :phone, required: true, autocomplete: "tel", placeholder: "0803 123 4567", class: "input" %>
    <p class="hint">You'll log in with this number. Any format is fine.</p>
  </div>

  <div>
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input" %>
  </div>

  <div>
    <%= form.label :password, class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password",
          minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, class: "input" %>
    <p class="hint">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</p>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm password", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>

  <%= form.submit "Create account", class: "btn-primary" %>
<% end %>

<p class="mt-6 text-sm text-gray-600">
  Already have an account? <%= link_to "Log in", new_session_path, class: "link" %>
</p>
