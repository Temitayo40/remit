<% content_for :title, "Vehicles · Remit" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Vehicles</h1>
  <%= link_to "Add vehicle", new_vehicle_path, class: "btn-primary w-auto" %>
</div>

<% if @vehicles.any? %>
  <div id="vehicles" class="space-y-3">
    <%= render @vehicles %>
  </div>
<% else %>
  <div class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-600">
    No vehicles yet. Add your first keke, okada or bus to start tracking remittance.
  </div>
<% end %>

<% if @inactive_vehicles.any? %>
  <details class="mt-8">
    <summary class="cursor-pointer text-sm font-medium text-gray-600">Out of service (<%= @inactive_vehicles.size %>)</summary>
    <div id="inactive_vehicles" class="mt-3 space-y-3 opacity-70">
      <%= render @inactive_vehicles %>
    </div>
  </details>
<% end %>
