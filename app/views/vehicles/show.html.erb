<% content_for :title, "#{@vehicle.plate_number} · Remit" %>

<%= link_to "← Vehicles", vehicles_path, class: "text-sm text-gray-600 hover:text-gray-900" %>

<div class="mt-2 flex items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold"><%= @vehicle.plate_number %></h1>
    <% if @vehicle.nickname %><p class="text-gray-600"><%= @vehicle.nickname %></p><% end %>
  </div>
  <%= link_to "Edit", edit_vehicle_path(@vehicle), class: "btn-secondary w-auto" %>
</div>

<% unless @vehicle.active? %>
  <p class="mt-4 rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-700">Out of service</p>
<% end %>

<dl class="mt-6 divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
  <div class="flex justify-between p-4">
    <dt class="text-gray-600">Type</dt>
    <dd class="font-medium"><%= @vehicle.vehicle_type.humanize %></dd>
  </div>
  <div class="flex justify-between p-4">
    <dt class="text-gray-600">Amount due</dt>
    <dd class="font-medium"><%= naira(@vehicle.rate_kobo) %> / <%= @vehicle.daily? ? "day" : "week" %></dd>
  </div>
  <% if @vehicle.daily? %>
    <div class="flex justify-between p-4">
      <dt class="text-gray-600">Rest days</dt>
      <dd class="font-medium"><%= @vehicle.rest_days.any? ? @vehicle.rest_day_names : "None" %></dd>
    </div>
  <% end %>
</dl>

<p class="mt-6 text-sm text-gray-500">The current driver and balance will show here once you assign a driver (next phase).</p>
