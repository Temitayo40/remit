<% content_for :title, "Drivers · Remit" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Drivers</h1>
  <%= link_to "Add driver", new_driver_path, class: "btn-primary w-auto" %>
</div>

<% if @drivers.any? %>
  <div id="drivers" class="space-y-3">
    <%= render @drivers %>
  </div>
<% else %>
  <div class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-center text-sm text-gray-600">
    No drivers yet. Add the people who drive your vehicles.
  </div>
<% end %>

<% if @inactive_drivers.any? %>
  <details class="mt-8">
    <summary class="cursor-pointer text-sm font-medium text-gray-600">No longer driving (<%= @inactive_drivers.size %>)</summary>
    <div id="inactive_drivers" class="mt-3 space-y-3 opacity-70">
      <%= render @inactive_drivers %>
    </div>
  </details>
<% end %>
